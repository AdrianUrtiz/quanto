// Quanto — PWA control de gastos personales y en pareja
// Prisma 6 + PostgreSQL (Vercel Postgres / Neon)
// Despliegue: `npx prisma migrate deploy` en Vercel Build.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  DEBIT
  CREDIT
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

// Categoría libre (String) para permitir personalizadas:
// códigos del catálogo o `custom:{emoji}:{NOMBRE}`.

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String // hash bcrypt (Auth.js Credentials)
  name      String
  avatar    String?
  // Código personal de vínculo Q-XXXXXX (Ajustes > Pareja). Se genera al primer uso.
  pairCode  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts                Account[]
  transactions            Transaction[]        @relation("CreatedBy")
  debts                   TransactionShare[]   @relation("Debtor")
  subscriptions           Subscription[]
  categories              Category[]
  paymentsRegistered      DebtPayment[]        @relation("PaymentRegistrar")
  paymentsConfirmed       DebtPayment[]        @relation("PaymentConfirmer")
  settlementsRegistered   GroupSettlement[]    @relation("SettlementRegistrar")
  settlementsConfirmed    GroupSettlement[]    @relation("SettlementConfirmer")
  chargesOwnerPaid        SubscriptionCharge[] @relation("ChargeOwnerPayer")
  chargesPartnerPaid      SubscriptionCharge[] @relation("ChargePartnerPayer")
  householdMembers        HouseholdMember[]
  householdsCreated       Household[]          @relation("HouseholdCreator")
  invitesSent             CoupleInvite[]       @relation("InviteFrom")
  invitesReceived         CoupleInvite[]       @relation("InviteTo")
  expenseClaimsRegistered GroupExpenseClaim[]
}

model Account {
  id     String      @id @default(cuid())
  name   String // ej. "BBVA Débito", "Nu Crédito"
  type   AccountType
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastFour   String?
  expiry     String? // vencimiento MM/AA
  color      String? @default("#6366f1")
  // Orden manual (menor = primero) y favorita (siempre primera y
  // preseleccionada en formularios). Una sola favorita por usuario
  // (se garantiza en los server actions).
  position   Int     @default(0)
  isFavorite Boolean @default(false)
  isActive   Boolean @default(true)
  // Oculta manual (cuentas en ceros que casi no se usan): fuera de listas,
  // totales y selectores; el historial se conserva.
  isHidden   Boolean @default(false)

  // — Débito: solo saldo inicial; los ingresos se registran manual —
  initialBalance Decimal? @db.Decimal(12, 2)

  // — Crédito —
  creditLimit  Decimal? @db.Decimal(12, 2)
  statementDay Int? // día de corte 1-31
  dueDay       Int? // día límite de pago 1-31

  // Saldo calculado desde movimientos (lib/balances.ts):
  //  - DEBIT  → initialBalance + ingresos - gastos - traspasos fuera + traspasos dentro.
  //  - CREDIT → deuda = gastos - abonos + traspasos fuera - pagos recibidos.

  transactions  Transaction[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  debtPayments         DebtPayment[]     @relation("PaymentAccount")
  debtorSourcePayments DebtPayment[]     @relation("DebtorPaymentAccount")
  settlementCredits    GroupSettlement[] @relation("SettlementAccount")
  settlementDebits     GroupSettlement[] @relation("SettlementDebtorAccount")

  @@index([userId])
}

model Transaction {
  id       String          @id @default(cuid())
  type     TransactionType @default(EXPENSE)
  amount   Decimal         @db.Decimal(12, 2) // monto TOTAL de la compra
  concept  String
  category String          @default("OTRO")
  date     DateTime        @default(now())
  notes    String?

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  // Meses sin intereses: 1 = contado, 3/6/12 = parcialidades.
  // Cuota mensual total = amount / installments.
  installments Int @default(1)

  // Gasto compartido en pareja (por defecto 50/50 vía TransactionShare).
  isShared Boolean            @default(false)
  shares   TransactionShare[]

  // Solo para TRANSFER: cuenta destino.
  transferToAccountId String?

  // Solo para pagos a tarjeta: período ("YYYY-MM", mes del corte) al que
  // se aplica el pago aunque sea extemporáneo (botón Pagar del período).
  // Null = se asigna por fecha (ventana hasta la fecha límite de pago).
  statementKey String?

  // Solo para cargos confirmados de suscripción.
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  // Grupo al que pertenece el gasto (GROUP). Null = personal o pareja (compat legacy).
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  // Cargo mensual de suscripción (nuevo modelo checklist).
  charges SubscriptionCharge[]

  debtPayment         DebtPayment?     @relation("PaymentTransaction")
  debtorSourcePayment DebtPayment?     @relation("DebtorPaymentTransaction")
  settlementCredit    GroupSettlement? @relation("SettlementTransaction")
  settlementDebit     GroupSettlement? @relation("SettlementDebtorTransaction")

  // Llave de idempotencia para subidas offline (outbox): el cliente genera
  // `temp-<uuid>` y el servidor la guarda una sola vez. Los reintentos con
  // la misma llave devuelven ok sin duplicar. Null = creado online.
  clientKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([accountId])
  @@index([createdById])
  @@index([subscriptionId])
  @@index([statementKey])
  @@index([householdId])
}

// Catálogo de categorías: filas globales del sistema (userId null, isDefault)
// + personalizadas de cada usuario. Transaction.category guarda el `code`.
model Category {
  id        String  @id @default(cuid())
  code      String // "COMIDA" o "cXXXXXXXXXXX" para personalizadas
  name      String // "Comida"
  iconName  String  @default("Shapes")
  color     String  @default("#71717a")
  kind      String  @default("expense") // expense | income | both
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, code])
  @@index([userId])
}

// Plantilla de cargo recurrente mes a mes (ej. Spotify, Netflix).
// Los cargos se confirman manualmente y nacen como Transaction vinculadas.
model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  amount   Decimal @db.Decimal(12, 2)
  category String  @default("SUSCRIPCIONES")

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  chargeDay Int // día de cobro 1-31 (se ajusta al último día del mes si no existe)

  isShared     Boolean  @default(false)
  // Reparto: porcentaje o cantidad fija total. Solo referencia para el split
  // al confirmar; los pagos se registran en Pareja, no aquí.
  sharePct     Float    @default(50)
  shareAmount  Decimal? @db.Decimal(12, 2)
  // Compartida con alguien SIN usuario de la app (ej. "Mamá"): solo se guarda
  // su nombre. En ese caso no se resuelve pareja al confirmar el cargo.
  externalName String?

  isActive   Boolean @default(true) // false = pausada
  // Primer mes a generar, "YYYY-MM" (por defecto el mes de creación).
  startMonth String

  transactions Transaction[]
  charges      SubscriptionCharge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Instancia mensual de una suscripción: el cargo + checklist de pagos.
// Sin transacciones asociadas salvo el movimiento del cargo en sí.
model SubscriptionCharge {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // Mes del cargo, "YYYY-MM".
  month String

  // Movimiento del cargo total en la tarjeta (creado al confirmar).
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  // Mes omitido por el dueño ("no se cobró"): sin movimiento ni deuda.
  // Excluye el mes de pendientes e historial como no cobrado.
  skipped Boolean @default(false)

  // Checks: el dueño cubrió lo suyo (nace true al confirmar) / la pareja pagó su parte.
  ownerPaid   Boolean @default(false)
  partnerPaid Boolean @default(false)

  ownerPaidById   String?
  ownerPaidBy     User?   @relation("ChargeOwnerPayer", fields: [ownerPaidById], references: [id], onDelete: SetNull)
  partnerPaidById String?
  partnerPaidBy   User?   @relation("ChargePartnerPayer", fields: [partnerPaidById], references: [id], onDelete: SetNull)

  ownerPaidAt   DateTime?
  partnerPaidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, month])
  @@index([subscriptionId])
}

model TransactionShare {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  // Quién DEBE aportar (normalmente la pareja del creador).
  // - Pareja: userId de la pareja (siempre presente).
  // - Grupo: seat del grupo (siempre presente); debtorId se rellena al
  //   reclamar el seat (dual-write para que los flujos por shareId/debtorId
  //   existentes sigan funcionando). Null = seat aún libre.
  // - Externo (sin usuario en la app): debtorId null + externalName.
  debtorId String?
  debtor   User?   @relation("Debtor", fields: [debtorId], references: [id], onDelete: Cascade)

  // Nombre de la persona sin cuenta con quien se comparte (ej. "Mamá").
  // Excluyente con debtorId/seatId: es un compartido "de recordatorio".
  externalName String?

  seatId String?
  seat   HouseholdMember? @relation("SeatDebtor", fields: [seatId], references: [id], onDelete: SetNull)

  // Porcentaje del total que le toca al deudor (50 = mitad).
  sharePct Float @default(50)

  // Aportación MENSUAL del deudor = amount * sharePct/100 / installments.
  // Ej: $3,000 a 3 MSI 50/50 → $500/mes durante 3 meses.
  monthlyAmount Decimal @db.Decimal(12, 2)

  // true: monto fijo pactado (ej. $125 de $400) — editar el total NO lo recalcula.
  isFixedAmount Boolean @default(false)

  settled Boolean @default(false)

  payments DebtPayment[]

  createdAt DateTime @default(now())

  @@index([transactionId])
  @@index([debtorId])
  @@index([seatId])
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum HouseholdKind {
  COUPLE
  GROUP
}

enum HouseholdStatus {
  ACTIVE
  CLOSED
}

enum SettlementStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// Liquidación neteada entre dos seats de un grupo: quién le pagó a quién.
// A diferencia de DebtPayment (atado a un share), la transferencia neta
// salda saldos, no líneas: así se reproduce "cobré los netos y no pagué nada".
model GroupSettlement {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // Quién paga → a quién le paga (seats; el acreedor confirma con su cuenta).
  fromSeatId String
  fromSeat   HouseholdMember @relation("SettlementFrom", fields: [fromSeatId], references: [id], onDelete: Cascade)
  toSeatId   String
  toSeat     HouseholdMember @relation("SettlementTo", fields: [toSeatId], references: [id], onDelete: Cascade)

  amount Decimal          @db.Decimal(12, 2)
  status SettlementStatus @default(PENDING)

  registeredById String
  registeredBy   User   @relation("SettlementRegistrar", fields: [registeredById], references: [id], onDelete: Cascade)

  confirmedById String?
  confirmedBy   User?   @relation("SettlementConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  // Ingreso del acreedor al confirmar/recibir (en su propia cuenta).
  accountId     String?
  account       Account?     @relation("SettlementAccount", fields: [accountId], references: [id], onDelete: SetNull)
  transactionId String?      @unique
  transaction   Transaction? @relation("SettlementTransaction", fields: [transactionId], references: [id], onDelete: SetNull)

  // Egreso del deudor (su propia cuenta, opcional al registrar o confirmar origen).
  debtorAccountId     String?
  debtorAccount       Account?     @relation("SettlementDebtorAccount", fields: [debtorAccountId], references: [id], onDelete: SetNull)
  debtorTransactionId String?      @unique
  debtorTransaction   Transaction? @relation("SettlementDebtorTransaction", fields: [debtorTransactionId], references: [id], onDelete: SetNull)
  debtorConfirmedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([fromSeatId])
  @@index([toSeatId])
  @@index([status])
}

// Gasto grupal registrado POR otro miembro ("quien pagó" no soy yo).
// El pagador lo confirma eligiendo de qué cuenta suya salió; ahí nace el
// Transaction real con sus shares. Sin confirmar no mueve saldos.
model GroupExpenseClaim {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  concept  String
  amount   Decimal  @db.Decimal(12, 2)
  category String   @default("OTRO")
  date     DateTime

  // Seat que supuestamente pagó (puede estar sin reclamar: espera).
  payerSeatId String
  payerSeat   HouseholdMember @relation("ClaimPayer", fields: [payerSeatId], references: [id], onDelete: Cascade)

  // Quien lo registró (normalmente otro miembro).
  registeredById String
  registeredBy   User   @relation(fields: [registeredById], references: [id], onDelete: Cascade)

  // Reparto: [{ seatId, amount }] en pesos. Suma = amount.
  splits       Json
  // Si quien pagó también consume (si no, el reparto debe sumar el total).
  payerInSplit Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

// Hogar compartido: COUPLE (máx 2, vínculo con aceptación) o GROUP
// (seats libres por nombre, claim directo con código reutilizable).
// Un usuario puede estar en 1 COUPLE + N GROUP a la vez.
// Un GROUP CLOSED está liquidado: no acepta movimientos ni integrantes.
model Household {
  id            String              @id @default(cuid())
  // GROUP: código reutilizable G-XXXXXX que se comparte.
  // COUPLE: código Q-XXXXXX de referencia (el vínculo real va por invite).
  code          String?             @unique
  kind          HouseholdKind
  status        HouseholdStatus     @default(ACTIVE)
  name          String?
  createdById   String
  createdBy     User                @relation("HouseholdCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members       HouseholdMember[]
  transactions  Transaction[]
  expenseClaims GroupExpenseClaim[]
  settlements   GroupSettlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

// Miembro o seat de un household.
// - COUPLE: siempre con userId (2 miembros).
// - GROUP: seat con displayName libre; userId null = libre, con userId = ocupado.
//   El displayName no tiene por qué matchear el username (ej. seat "Chispa" reclamado por Brenda).
model HouseholdMember {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  displayName String
  joinedAt    DateTime @default(now())

  // Shares de gastos grupales que debe este seat (dual-write con debtorId).
  seatShares  TransactionShare[]  @relation("SeatDebtor")
  // Gastos que este seat supuestamente pagó (por confirmar con su cuenta).
  paidClaims  GroupExpenseClaim[] @relation("ClaimPayer")
  // Liquidaciones neteadas donde participa (solo CONFIRMED mueve saldos).
  settledFrom GroupSettlement[]   @relation("SettlementFrom")
  settledTo   GroupSettlement[]   @relation("SettlementTo")

  // Un usuario ocupa un solo seat por household (NULLs múltiples permitidos en PG).
  @@unique([householdId, userId])
  // Sin seats duplicados por nombre dentro del mismo household.
  @@unique([householdId, displayName])
  @@index([userId])
}

// Solicitud de vínculo de pareja: A pega el pairCode de B → PENDING para B.
// Al aceptar se crea el Household COUPLE con ambos. Expira en 48h.
model CoupleInvite {
  id         String       @id @default(cuid())
  fromUserId String
  fromUser   User         @relation("InviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User         @relation("InviteTo", fields: [toUserId], references: [id], onDelete: Cascade)
  status     InviteStatus @default(PENDING)
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([toUserId, status])
  @@index([fromUserId, status])
}

// Abono a la parcialidad de un mes de un gasto compartido.
// - Si registra el ACREEDOR (recibe): CONFIRMED directo + ingreso en su cuenta.
// - Si registra el DEUDOR (paga): PENDING hasta que el acreedor confirma.
// El movimiento de dinero siempre lo crea el dueño de la cuenta.
model DebtPayment {
  id      String           @id @default(cuid())
  shareId String
  share   TransactionShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  // Parcialidad a la que se abona, "YYYY-MM".
  month  String
  amount Decimal @db.Decimal(12, 2)

  status PaymentStatus @default(PENDING)

  registeredById String
  registeredBy   User   @relation("PaymentRegistrar", fields: [registeredById], references: [id], onDelete: Cascade)

  confirmedById String?
  confirmedBy   User?   @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  // Cuenta propia afectada (destino del ingreso u origen del egreso).
  accountId String?
  account   Account? @relation("PaymentAccount", fields: [accountId], references: [id], onDelete: SetNull)

  // Movimiento generado (ingreso del acreedor o egreso del deudor).
  transactionId String?      @unique
  transaction   Transaction? @relation("PaymentTransaction", fields: [transactionId], references: [id], onDelete: SetNull)

  // Lado deudor: de qué cuenta salió el dinero que el acreedor dice recibido.
  // Se llena cuando el deudor confirma el origen (o al confirmar su propio registro).
  debtorAccountId     String?
  debtorAccount       Account?     @relation("DebtorPaymentAccount", fields: [debtorAccountId], references: [id], onDelete: SetNull)
  debtorTransactionId String?      @unique
  debtorTransaction   Transaction? @relation("DebtorPaymentTransaction", fields: [debtorTransactionId], references: [id], onDelete: SetNull)
  debtorConfirmedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shareId, month])
  @@index([registeredById])
  @@index([status])
}
